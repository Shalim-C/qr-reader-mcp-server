# Env vars (also settable via env in MCP client config)
# LOG_LEVEL=info              # debug | info | warning | error
# READ_ONLY_MODE=false        # true = disable enhance_and_decode + auto_enhance
# MAX_IMAGE_SIZE=10485760     # max image bytes (default 10 MB)
# MAX_INPUT_PIXELS=4096       # max longer-edge pixels before auto-resize
# --- Quality metric normalization anchors (all optional) ---
# QR_BLUR_THRESHOLD=50.0      # Laplacian-variance normalization (blur contribution = threshold / variance)
# QR_CONTRAST_PERFECT=0.50    # contrast "ideal" value; closer = healthier
# QR_MODULATION_PERFECT=0.70  # ISO 15415 modulation ratio "ideal" value
# QR_GLARE_MAX=0.30           # glare normalization upper bound
# QR_NOISE_MAX=50.0           # noise normalization upper bound
# QR_ANGLE_MAX=30.0           # distortion angle normalization upper bound (degrees)
# QR_LEG_RATIO_MIN=0.60       # distortion leg-ratio normalization lower bound
