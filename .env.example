# Env vars (also settable via env in MCP client config)
# LOG_LEVEL=info              # debug | info | warning | error
# READ_ONLY_MODE=false        # true = disable enhance_and_decode + auto_enhance
# MAX_IMAGE_SIZE=10485760     # max image bytes (default 10 MB)
# MAX_INPUT_PIXELS=2560       # max longer-edge pixels before auto-resize
# QR_BLUR_THRESHOLD=50.0      # blur threshold, lower = stricter
# QR_CONTRAST_THRESHOLD=0.20  # contrast threshold (std/128), lower = stricter
# QR_GLARE_THRESHOLD=0.10     # glare threshold (spatial variance), lower = stricter
